generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid())
  name               String?
  email              String     @unique
  emailVerified      DateTime?
  avatarUrl          String?
  password           String?
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  isTwoFactorEnabled Boolean    @default(false)
  twofactorSecret    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  accounts           Account[]
  projects           Project[]
  sessions           Session[]
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_Token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id      String   @id @default(uuid())
  session String   @unique
  userId  String
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1. Informations générales du projet
  name     String
  client   String?
  location String?

  // Relations vers les sous-modèles
  user                 User                  @relation(fields: [userId], references: [id])
  powerSupply          PowerSupply?
  circuits             Circuit[]
  cableData            CableData?
  protection           Protection?
  upstreamProtection   UpstreamProtection?
  result               Result?
  furthestLoadDistance FurthestLoadDistance?
}

// 2. Caractéristiques de l'alimentation électrique
model PowerSupply {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type                 AlimentationType
  nominalVoltage       Float
  frequency            Float
  regimeNeutre         RegimeNeutre
  distanceSourceToTGBT Float
  standard             Standard
}

// 3. Circuit électrique
model Circuit {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                     String
  circuitCount             Int             @default(1)
  type                     CircuitType
  totalPower               Float
  cosPhi                   Float           @default(1)
  utilizationFactor        Float           @default(1)
  simultaneityFactor       Float           @default(1)
  distance                 Float?
  cableMaterial            CableMaterial?
  cableIsolation           CableIsolation?
  modePose                 ModePose?
  correctionFactors        Json?
  izReference              Float?
  millivoltsPerAmpereMeter Float?
  protectionType           ProtectionType?
  ratedCurrent             Float?
  numberOfPoles            Int?
  curveType                CurveType?
  breakingCapacity         Float?
  selectivityVerified      Boolean         @default(false)
}

// 4. Distance entre la charge la plus éloignée et le tableau divisionnaire
model FurthestLoadDistance {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  circuitName String
  distance    Float
}

// 5. Données concernant les câbles
model CableData {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  material  CableMaterial
  isolation CableIsolation
  modePose  ModePose
}

// 6. Choix des protections
model Protection {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type              ProtectionType
  ratedCurrent      Float
  numberOfPoles     Int
  curveType         CurveType
  breakingCapacity  Float
  manufacturer      String?
  reference         String?
  selectivityLimitA Float?
}

model UpstreamProtection {
  id                String         @id @default(cuid())
  projectId         String         @unique
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type              ProtectionType
  ratedCurrent      Float
  numberOfPoles     Int
  curveType         CurveType
  breakingCapacity  Float
  manufacturer      String?
  reference         String?
  selectivityLimitA Float?
}

// 7. Résultats calculés et vérifications
model Result {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  currentNominal           Float
  currentDesign            Float
  recommendedCableSection  Float
  correctedCableCapacity   Float
  recommendedBreaker       Float
  voltageDropVolts         Float
  voltageDropPercent       Float
  shortCircuitCurrentAtEnd Float
  breakerBreakingCapacity  Float
  overloadCheck            CheckStatus
  voltageDropCheck         CheckStatus
  breakingCapacityCheck    CheckStatus
  coordinationCheck        CheckStatus
}

// ==========================================
// ENUMS ÉLECTRIQUES
// ==========================================
enum AlimentationType {
  MONOPHASE
  TRIPHASE
}

enum RegimeNeutre {
  TT
  TN
  IT
}

enum CircuitType {
  ECLAIRAGE
  PRISE_COURANT
  FORCE_MOTRICE
  CHAUFFAGE
  CLIMATISATION
  AUTRE
}

enum CableMaterial {
  CUIVRE
  ALUMINIUM
}

enum CableIsolation {
  PVC
  XLPE
  EPR
}

enum ModePose {
  SOUS_CONDUIT_EN_SAILLIE
  ENCASTRE_DANS_MUR
  CHEMINEE_DE_CABLES
  ENTERRE
  AIR_LIBRE
}

enum ProtectionType {
  DISJONCTEUR
  FUSIBLE
  INTERRUPTEUR_SECTIONNEUR
}

enum CurveType {
  B
  C
  D
  K
  Z
}

enum CheckStatus {
  PASS
  FAIL
  TO_VERIFY_WITH_MANUFACTURER
}

enum Standard {
  NFC_15_100
  CEI_60364
  IEEE_141
  IEEE_242
}
